{
  "name": "gen-ai-tools",
  "version": "1.0.0",
  "description": "Local Generative AI tools: CLI scripts, webservice, UIs",
  "license": "ISC",
  "author": "Peter Kin",
  "type": "module",
  "main": "comfyui/batch.mjs",
  "scripts": {
    "------------------ comfyui -------------------": "",
    "comfy-batch": "node comfyui/batch.mjs",
    "convert-all": "node comfyui/jobs/convert.mjs",
    "dist-browser": "node dist-browser/serve.mjs",
    "dist-browser:build": "vite build --config dist-browser/vite.config.mjs",
    "dist-browser:dev": "vite --config dist-browser/vite.config.mjs",
    "------------------ tools-hub -----------------": "",
    "tools-hub": "node tools-hub/index.mjs",
    "------------------ logging -------------------": "",
    "log-cleanup": "node logging/mongodb/cleanup-log.mjs",
    "log-backup": "node logging/mongodb/backup-log.mjs",
    "------------------ runpod --------------------": "",
    "start-pod": "node runpod/start-pod.mjs",
    "stop-pod": "node runpod/stop-pod.mjs",
    "------------------ development ---------------": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  }
}
