# URL for the ComfyUI backend (local or remote)
COMFY_SERVER=http://127.0.0.1:8188

# How often to poll the backend while waiting for a job, in milliseconds.
# Optional, defaults to 5000.
COMFY_POLL_INTERVAL_MS=2000

# Whether the app should keep the original ComfyUI png files
COMFY_KEEP_ORIGINALS=false

# API key to access RunPod REST API v2, optional
RUNPOD_API_KEY=

# MongoDB connection URI for logging
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.iiy2wob.mongodb.net/

# AWS credentials to access logging features (deprecated)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DynamoDB table name of logs
AWS_LOGS_TABLE_NAME=
# Lambda name for finding logs
AWS_LOGS_FIND_LAMBDA_NAME=

# URL of the log finder lambda function
LOG_FIND_LAMBDA_URL=

# FTP data for UI deployment
FTP_HOST=
FTP_USER=
FTP_PASS=
LOG_FIND_UI_FTP_FOLDER=

# Tools hub (local webserver) port
TOOLS_HUB_PORT=4218