## --------- COMFYUI --------------

# URL for the ComfyUI backend (local or remote)
COMFY_SERVER=http://127.0.0.1:8188

# Absolute path to load comfyui assets (workflows, inputs, etc) from
COMFY_ASSETS_PATH=/Users/your-name/path/to/comfyui

# Absolute path to comfyui dist folder (defaults to <repo>/dist)
COMFY_DIST_PATH=/Users/your-name/path/to/dist

# How often to poll the backend while waiting for a job, in milliseconds.
# Optional, defaults to 5000.
COMFY_POLL_INTERVAL_MS=2000

# Whether the app should keep the original ComfyUI png files
COMFY_KEEP_ORIGINALS=false

# API key to access RunPod REST API v2, optional
RUNPOD_API_KEY=

## --------- LOGGING --------------

# MongoDB connection URI for logging
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.iiy2wob.mongodb.net/

## --------- TOOLS HUB ------------

# Tools hub (local webserver) port
TOOLS_HUB_PORT=4218

# Set to 1/true/yes to skip the Vite build of the dist-browser UI on tools-hub startup
TOOLS_HUB_SKIP_UI_BUILD=

## --------- AI GATEWAY -----------

# AI Gateway (webserver) port
AIGW_PORT=4218

# `Input` image upload folders for the comfyui instances on the AI server
AIGW_MY_IMAGE_UPLOADS_FOLDER=/Users/path/to/ComfyUI/input
AIGW_CY_IMAGE_UPLOADS_FOLDER=/Users/path/to/ComfyUI/input
