[
  {
    "workflow": {
      "UNETLoader_Base": {
        "class_type": "UNETLoader",
        "inputs": {
          "unet_name": "<base_flux_model>.safetensors",
          "weight_dtype": "default"
        }
      },
      "CLIPLoader_Base": {
        "class_type": "CLIPLoader",
        "inputs": {
          "clip_name": "<text_encoder>.safetensors",
          "type": "flux2",
          "device": "default"
        }
      },
      "VAELoader_Base": {
        "class_type": "VAELoader",
        "inputs": {
          "vae_name": "<flux_vae>.safetensors"
        }
      },
      "EmptyLatentImage": {
        "class_type": "EmptyLatentImage",
        "inputs": {
          "batch_size": 1,
          "height": 1200,
          "width": 768
        }
      },
      "LoadImage_1": {
        "class_type": "LoadImage",
        "inputs": {
          "image": "only-reference.jpg"
        }
      },
      "ImageScaleToTotalPixels_1": {
        "class_type": "ImageScaleToTotalPixels",
        "inputs": {
          "image": ["LoadImage_1", 0],
          "upscale_method": "nearest-exact",
          "megapixels": 1.5,
          "resolution_steps": 8
        }
      },
      "VAEEncode_Reference_1": {
        "class_type": "VAEEncode",
        "inputs": {
          "pixels": ["ImageScaleToTotalPixels_1", 0],
          "vae": ["VAELoader_Base", 0]
        }
      },
      "PositiveCLIP_Base": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "clip": ["CLIPLoader_Base", 0],
          "text": "turn the person from the reference photo into a watercolor portrait"
        }
      },
      "ConditioningZeroOut_Negative": {
        "class_type": "ConditioningZeroOut",
        "inputs": {
          "conditioning": ["PositiveCLIP_Base", 0]
        }
      },
      "ReferenceLatent_Positive_1": {
        "class_type": "ReferenceLatent",
        "inputs": {
          "conditioning": ["PositiveCLIP_Base", 0],
          "latent": ["VAEEncode_Reference_1", 0]
        }
      },
      "ReferenceLatent_Negative_1": {
        "class_type": "ReferenceLatent",
        "inputs": {
          "conditioning": ["ConditioningZeroOut_Negative", 0],
          "latent": ["VAEEncode_Reference_1", 0]
        }
      },
      "FluxKVCache_Model": {
        "class_type": "FluxKVCache",
        "inputs": {
          "model": ["UNETLoader_Base", 0]
        }
      },
      "Sampler": {
        "class_type": "KSampler",
        "inputs": {
          "model": ["FluxKVCache_Model", 0],
          "seed": 1000000001,
          "steps": 4,
          "cfg": 1,
          "sampler_name": "euler",
          "scheduler": "simple",
          "positive": ["ReferenceLatent_Positive_1", 0],
          "negative": ["ReferenceLatent_Negative_1", 0],
          "latent_image": ["EmptyLatentImage", 0],
          "denoise": 1
        }
      },
      "VAEDecode_1": {
        "class_type": "VAEDecode",
        "inputs": {
          "samples": ["Sampler", 0],
          "vae": ["VAELoader_Base", 0]
        }
      },
      "SaveImage": {
        "class_type": "SaveImage",
        "inputs": {
          "images": ["VAEDecode_1", 0],
          "filename_prefix": "flux2-img2img"
        }
      }
    },
    "input": {
      "base-workflow": "img2img-base",
      "inputs": ["only-reference.jpg"],
      "prompt": [
        "turn the person from the reference photo into a watercolor portrait"
      ]
    }
  }
]
